      "source": "def predict(history, action):\n    grid = np.array(history.frames[-1], dtype=np.int8)\n    kind = int(action.kind)\n    if kind == 6:\n        row = int(action.row)\n        col = int(action.col)\n        # Toggle the target cell based on its current value\n        if grid[row, col] == 0:\n            grid[row, col] = 14 # Place green (goal-like)\n        elif grid[row, col] == 14:\n            grid[row, col] = 0 # Remove green\n        else:\n            grid[row, col] = 0 # Clear other colors\n    elif kind in [3, 4]:\n        # Component-wide toggle: clear all non-background non-goal cells\n        mask = (grid > 0) & (grid != 14)\n        grid[mask] = 0\n    elif kind == 5:\n        # Selection: highlight the largest contiguous component\n        flat = grid.flatten()\n        flat[flat == 0] = -1\n        flat[flat == 14] = -1\n        components = np.unique(flat[flat != -1], return_counts=True)\n        if len(components) > 1:\n            max_val = components[1][0]\n            grid[grid == max_val] = 14\n    return {\"next_grid\": grid, \"game_state\": \"NOT_FINISHED\", \"level_delta\": 0, \"memory\": {}}\n\ndef goal_value(history):\n    return 0.5",
