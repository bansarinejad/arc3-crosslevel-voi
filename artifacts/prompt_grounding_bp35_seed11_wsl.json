      "source": "def predict(history, action):\n    grid = np.array(history.frames[-1], dtype=np.int8)\n    kind = int(action.kind)\n    if kind == 6:\n        row = int(action.row)\n        col = int(action.col)\n        # Check if the target cell is accessible (not black)\n        if grid[row, col] != 5:\n            # Move the agent (blue) to the target if it's not already there\n            blue_pos = np.argwhere(grid == 9)\n            if len(blue_pos) > 0:\n                current_r, current_c = blue_pos[0]\n                if (current_r, current_c) != (row, col):\n                    # Swap colors: move blue to target, yellow to blue's old spot\n                    grid[row, col] = 9\n                    grid[current_r, current_c] = 11\n                    # Move the yellow object to the blue's old spot\n                    yellow_pos = np.argwhere(grid == 11)\n                    if len(yellow_pos) > 0:\n                        yellow_r, yellow_c = yellow_pos[0]\n                        grid[yellow_r, yellow_c] = 9\n                        grid[current_r, current_c] = 11\n    return {\"next_grid\": grid, \"game_state\": \"NOT_FINISHED\", \"level_delta\": 0, \"memory\": {}}\n\ndef goal_value(history):\n    # Check for win condition: agent (blue) should be near or on a specific target\n    grid = np.array(history.frames[-1], dtype=np.int8)\n    # Simple heuristic: check if blue is adjacent to green blocks\n    blue_pos = np.argwhere(grid == 9)\n    green_pos = np.argwhere(grid == 14)\n    \n    if len(blue_pos) > 0:\n        blue_r, blue_c = blue_pos[0]\n        if len(green_pos) > 0:\n            for gr, gc in green_pos:\n                if abs(blue_r - gr) <= 1 and abs(blue_c - gc) <= 1:\n                    return 0.9\n    return 0.5",
