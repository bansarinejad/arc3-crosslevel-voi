      "source": "def predict(history, action):\n    grid = np.array(history.frames[-1], dtype=np.int8)\n    kind = int(action.kind)\n    if kind == 6:\n        row = int(action.row)\n        col = int(action.col)\n        # ACTION6 interacts locally with cell contents\n        current_val = grid[row, col]\n        if current_val == 0:\n            grid[row, col] = 14 # Green\n        elif current_val == 14:\n            grid[row, col] = 0 # White\n    return {\"next_grid\": grid, \"game_state\": \"NOT_FINISHED\", \"level_delta\": 0, \"memory\": {}}\n\ndef goal_value(history):\n    # Check if the grid is full or has a specific pattern\n    grid = np.array(history.frames[-1], dtype=np.int8)\n    if np.all(grid == 14):\n        return 1.0\n    if np.sum(grid == 14) > np.sum(grid == 0) * 10:\n        return 0.9\n    return 0.0",
