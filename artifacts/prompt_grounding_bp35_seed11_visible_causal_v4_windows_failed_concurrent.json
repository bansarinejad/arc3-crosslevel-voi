      "simple_action_contract_ok": false,
      "source": "def predict(history, action):\n    kind = int(action.kind)\n    if kind == 6:\n        row = int(action.row)\n        col = int(action.col)\n    else:\n        row, col = None, None\n\n    # Conservative evidence-first baseline: reproduce observed transitions if any, else no effect\n    if len(history) > 1 and len(history[1].get('grid_values', [])) == len(history[0].get('grid_values', [])):\n        # If we have previous state, try to match previous transition if action is similar\n        pass\n\n    # No-effect baseline for this context: return current grid unchanged\n    grid = np.array(history.frames[-1], dtype=np.int8)\n    return {\"next_grid\": grid, \"game_state\": \"NOT_FINISHED\", \"level_delta\": 0, \"memory\": {}}\n\ndef goal_value(history):\n    # Evaluate progress based on visible objects and their states\n    if len(history) == 0:\n        return 0.0\n\n    last_frame = history[-1]\n    grid_values = last_frame.get('grid_values', [])\n    if not grid_values:\n        return 0.0\n\n    # Count presence of key objects: blue (9), yellow (11), green (14)\n    counts = {9: 0, 11: 0, 14: 0}\n    for v in grid_values:\n        if v in counts:\n            counts[v] += 1\n\n    # Normalize by total unique values present\n    unique_vals = set(grid_values)\n    if not unique_vals:\n        return 0.0\n\n    # Weighted progress: more blue/yellow/green cells = higher goal value\n    # Use a simple sum of counts for relevant colors divided by max possible\n    progress = (counts[9] + counts[11] + counts[14]) / (len(unique_vals) * 3)\n    return min(1.0, max(0.0, progress))",
