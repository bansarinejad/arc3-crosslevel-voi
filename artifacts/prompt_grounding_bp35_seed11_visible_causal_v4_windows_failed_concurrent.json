      "source": "def predict(history, action):\n    kind = int(action.kind)\n    grid = np.array(history.frames[-1], dtype=np.int8)\n    if kind == 6:\n        row = int(action.row)\n        col = int(action.col)\n        if 0 <= row < grid.shape[0] and 0 <= col < grid.shape[1]:\n            grid[row, col] = 10\n    return {\"next_grid\": grid, \"game_state\": \"NOT_FINISHED\", \"level_delta\": 0, \"memory\": {}}\n\ndef goal_value(history):\n    grid = np.array(history.frames[-1], dtype=np.int8)\n    target_values = [10]\n    mask = grid == target_values\n    if not np.any(mask):\n        return 0.0\n    count = np.count_nonzero(mask)\n    total = grid.size\n    return min(count / total, 1.0)",
