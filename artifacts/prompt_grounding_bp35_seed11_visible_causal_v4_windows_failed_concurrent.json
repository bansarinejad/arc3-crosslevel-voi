      "source": "def predict(history, action):\n    grid = np.array(history.frames[-1], dtype=np.int8)\n    kind = int(action.kind)\n    if kind == 6:\n        row = int(action.row)\n        col = int(action.col)\n        # Check if ACTION6 coordinates are within grid bounds (8x8 based on visual)\n        if 0 <= row < 8 and 0 <= col < 8:\n            # Simulate displacement of a connected component\n            # Identify the largest connected component of a specific color (e.g., blue=9)\n            target_color = 9\n            mask = grid == target_color\n            coords = np.argwhere(mask)\n            if len(coords) > 0:\n                # Pick a component and shift it slightly\n                # Simple shift: move up-left if possible\n                new_coords = []\n                for r, c in coords:\n                    nr, nc = r - 1, c - 1\n                    if 0 <= nr < 8 and 0 <= nc < 8:\n                        new_coords.append((nr, nc))\n                    else:\n                        new_coords.append((r, c))\n                grid = grid.copy()\n                # Clear old positions\n                for r, c in coords:\n                    grid[r, c] = 0\n                # Set new positions\n                for r, c in new_coords:\n                    grid[r, c] = target_color\n    return {\"next_grid\": grid, \"game_state\": \"NOT_FINISHED\", \"level_delta\": 0, \"memory\": {}}\n\ndef goal_value(history):\n    # Identify the blue component (color 9)\n    grid = np.array(history.frames[-1], dtype=np.int8)\n    target_color = 9\n    mask = grid == target_color\n    if np.any(mask):\n        coords = np.argwhere(mask)\n        count = len(coords)\n        # Normalize progress by component size\n        if count > 0:\n            return min(1.0, count / 100.0)\n    return 0.0",
