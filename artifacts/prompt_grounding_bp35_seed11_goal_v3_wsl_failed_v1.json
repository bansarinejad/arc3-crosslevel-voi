      "simple_action_contract_ok": false,
      "source": "def predict(history, action):\n    grid = np.array(history.frames[-1], dtype=np.int8)\n    kind = int(action.kind)\n    if kind == 6:\n        row = int(action.row)\n        col = int(action.col)\n        r, c = divmod(row, 8)\n        c_idx, r_idx = divmod(c, 8)\n        if 0 <= r_idx < 8 and 0 <= c_idx < 8:\n            target_r, target_c = r_idx, c_idx\n            if grid[target_r, target_c] == 14:\n                grid[target_r, target_c] = 10\n                grid[r, c] = 0\n    return {\"next_grid\": grid, \"game_state\": \"NOT_FINISHED\", \"level_delta\": 0, \"memory\": {}}\n\ndef goal_value(history):\n    grid = np.array(history.frames[-1], dtype=np.int8)\n    counts = np.bincount(grid.flatten(), minlength=16)\n    total = grid.size\n    if total == 0:\n        return 0.0\n    blue = counts[9]\n    light_blue = counts[10]\n    green = counts[14]\n    yellow = counts[11]\n    score = (blue + light_blue) / total\n    score = score * 0.5 + green / total * 0.3\n    score = score + yellow / total * 0.2\n    return float(np.clip(score, 0.0, 1.0))",
